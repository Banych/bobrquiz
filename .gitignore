# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/.playwright-mcp/
/playwright/.auth/

# agent worktrees (Claude Code)
/.claude/worktrees/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
src/infrastructure/database/prisma/generated/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Supabase CLI local link state (machine-specific, not project config)
supabase/.temp/

# Per-machine Claude Code overrides (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Plan workspaces (ledger, briefs, review diffs); commit a ledger with git add -f
/.superpowers/
